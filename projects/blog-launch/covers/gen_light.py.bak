# 36. Moodle quiz essay grading: 9 green auto-checked tiles + 1 navy human tile
def _quiz_grid():
    parts = ['<ellipse cx="600" cy="812" rx="360" ry="30" fill="#dbe6ea"/>']
    for i in range(10):
        c, r = i % 5, i // 5
        x, y = 169 + c * 178, 250 + r * 178
        if i < 9:
            parts.append(f'<rect x="{x}" y="{y}" width="150" height="150" rx="30" fill="#00d563" stroke="#002333" stroke-width="12"/>')
            parts.append(f'<path d="M{x+42} {y+78} l22 24 l44 -54" stroke="#ffffff" stroke-width="16" fill="none" stroke-linecap="round" stroke-linejoin="round"/>')
        else:
            parts.append(f'<rect x="{x}" y="{y}" width="150" height="150" rx="30" fill="#002333" stroke="#002333" stroke-width="12"/>')
            parts.append(f'<circle cx="{x+75}" cy="{y+58}" r="26" fill="#ffffff"/>')
            parts.append(f'<path d="M{x+33} {y+126} q0 -40 42 -40 q42 0 42 40 Z" fill="#ffffff"/>')
    return "\n  " + "\n  ".join(parts) + "\n"
SCENES["ai-grading-moodle-quiz-essay-questions"] = _quiz_grid()

