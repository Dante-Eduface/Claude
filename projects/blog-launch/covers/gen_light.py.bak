  <circle cx="900" cy="324" r="12" fill="#ffffff"/>
'''

for slug, scene in SCENES.items():
    html = WRAP_HEAD + scene.strip("\n") + WRAP_TAIL
    with open(os.path.join(OUT, slug + ".html"), "w") as f:
        f.write(html)


print(f"wrote {len(SCENES)} html files")
