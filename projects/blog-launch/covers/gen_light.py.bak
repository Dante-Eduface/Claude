#!/usr/bin/env python3
# Generates all blog covers in the LIGHT flat-icon style.
# Style: light bg #f3f7f8, grounding shadow #dbe6ea, navy #002333 outlines,
# green #00d563 fills, white shapes with navy outlines. One content-mapped icon per blog.
import os

OUT = os.path.join(os.path.dirname(__file__), "final")

WRAP_HEAD = ('<!doctype html><html><head><meta charset="utf-8"><style>'
             '*{margin:0;padding:0;box-sizing:border-box}html,body{width:1200px;height:900px}'
             'body{display:flex;align-items:center;justify-content:center}svg{display:block}'
             '</style></head><body>\n'
             '<svg width="1200" height="900" viewBox="0 0 1200 900" fill="none" '
             'xmlns="http://www.w3.org/2000/svg">\n'
             '<rect width="1200" height="900" fill="#f3f7f8"/>\n')
WRAP_TAIL = '\n</svg></body></html>'

